# ── Public site ───────────────────────────────────────────────────────────────
# Used for metadata, canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact form delivery (optional) ─────────────────────────────────────────
# Without these the form still validates both client- and server-side, and tells
# the visitor that delivery is not configured. No email is ever faked.
# Get a key at https://resend.com — keep it server-side only, never NEXT_PUBLIC_*.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL="Portfolio <hello@your-domain.com>"
